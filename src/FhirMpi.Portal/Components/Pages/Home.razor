@page "/"
@attribute [Authorize(Policy = "OperationsAccess")]
@implements IDisposable
@inject RegistryService Registry
@inject PortalActorContextFactory Actors
@inject Microsoft.Extensions.Options.IOptions<PortalOptions> PortalConfiguration
@inject ILogger<Home> Logger

<PageTitle>Operations overview · FhirMpi</PageTitle>

<PageHeader
    Eyebrow="Identity operations"
    Title="A clear view of your patient identity service"
    Description="Prioritise decisions, understand registry health and keep every action inside the active tenant boundary.">
    <Actions>
        <a class="button button-primary" href="/patients">Find a patient</a>
        <a class="button button-secondary" href="/reviews">Open review queue</a>
    </Actions>
</PageHeader>

@if (Error is not null)
{
    <div class="load-failure">
        <SubmissionFeedback Title="The overview could not be loaded" Message="@Error" />
        <button class="button button-secondary"
                type="button"
                disabled="@IsLoading"
                @onclick="LoadAsync">
            Try again
        </button>
    </div>
}
else if (IsLoading || Summary is null)
{
    <div class="loading-panel" role="status">
        <span class="loading-spinner" aria-hidden="true"></span>
        <span>Loading the tenant overview…</span>
    </div>
}
else
{
    <section class="metric-grid" aria-label="Registry overview">
        <article class="metric-card metric-primary">
            <span class="metric-label">Needs first review</span>
            <strong>@Summary.PendingReviews</strong>
            <span>Potential duplicates awaiting assessment</span>
        </article>
        <article class="metric-card metric-warning">
            <span class="metric-label">Second approval</span>
            <strong>@Summary.AwaitingSecondApproval</strong>
            <span>Governed actions ready for another reviewer</span>
        </article>
        <article class="metric-card">
            <span class="metric-label">24-hour activity</span>
            <strong>@Summary.RecentDecisions</strong>
            <span>Recent audited registry events</span>
        </article>
        <article class="metric-card">
            <span class="metric-label">Registry provider</span>
            <strong class="metric-word">@(Summary.Store.IsHealthy ? "Ready" : "Attention")</strong>
            <span>@Summary.Store.Provider</span>
        </article>
    </section>

    <div class="dashboard-grid">
        <section class="panel review-panel" aria-labelledby="priority-heading">
            <div class="section-heading">
                <div>
                    <p class="eyebrow">Priority work</p>
                    <h2 id="priority-heading">Identity reviews</h2>
                </div>
                <a class="text-link" href="/reviews">View all reviews</a>
            </div>

            @if (PriorityReviews.Count == 0)
            {
                <div class="compact-empty">
                    <span class="empty-check" aria-hidden="true">✓</span>
                    <div>
                        <strong>The queue is clear</strong>
                        <p>No identity reviews currently require attention.</p>
                    </div>
                </div>
            }
            else
            {
                <div class="review-list">
                    @foreach (var review in PriorityReviews)
                    {
                        <a class="review-row" href="/reviews/@review.Id">
                            <span class="review-kind">@PortalDisplay.ReviewKind(review.Kind)</span>
                            <span class="review-score">@review.Score.ToString("P0", CultureInfo.InvariantCulture)</span>
                            <span class="review-state">
                                @PortalDisplay.ReviewStatus(review.Status)
                                <small>@PortalDisplay.Instant(review.UpdatedAt)</small>
                            </span>
                            <span class="row-arrow" aria-hidden="true">→</span>
                        </a>
                    }
                </div>
            }
        </section>

        <aside class="panel policy-panel" aria-labelledby="policy-heading">
            <div class="section-heading">
                <div>
                    <p class="eyebrow">Current controls</p>
                    <h2 id="policy-heading">Matching policy</h2>
                </div>
                <a class="text-link" href="/settings">Manage</a>
            </div>
            <dl class="policy-facts">
                <div>
                    <dt>Profile</dt>
                    <dd>@Summary.Settings.MatchingProfileVersion</dd>
                </div>
                <div>
                    <dt>Possible threshold</dt>
                    <dd>@Summary.Settings.PossibleThreshold.ToString("P0", CultureInfo.InvariantCulture)</dd>
                </div>
                <div>
                    <dt>Probable threshold</dt>
                    <dd>@Summary.Settings.ProbableThreshold.ToString("P0", CultureInfo.InvariantCulture)</dd>
                </div>
                <div>
                    <dt>Link approvals</dt>
                    <dd>@Summary.Settings.RequiredLinkApprovals</dd>
                </div>
            </dl>
            <div class="source-strip">
                <span>@Summary.Settings.Sources.Count configured sources</span>
                <span>@Summary.Settings.Sources.Count(static source => source.IsAuthoritative) authoritative</span>
            </div>
        </aside>
    </div>

    <section class="safety-callout">
        <span class="safety-mark" aria-hidden="true">i</span>
        <div>
            <strong>Identity decisions have clinical consequences</strong>
            <p>Compare source records, resolve conflicting identifiers and record a meaningful reason before approving a link or split.</p>
        </div>
    </section>
}

@code {
    private RegistryOperationalSummary? Summary { get; set; }

    private IReadOnlyList<ReviewCase> PriorityReviews { get; set; } = [];

    private string? Error { get; set; }

    private bool IsLoading { get; set; } = true;

    private CancellationTokenSource ComponentLifetime { get; } = new();

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        IsLoading = true;
        Error = null;
        Summary = null;
        PriorityReviews = [];
        using var timeout = CancellationTokenSource.CreateLinkedTokenSource(
            ComponentLifetime.Token);
        timeout.CancelAfter(
            TimeSpan.FromSeconds(PortalConfiguration.Value.OverviewLoadTimeoutSeconds));

        try
        {
            var actor = await Actors.CreateAsync();
            var summaryTask = Registry.GetOperationalSummaryAsync(
                actor,
                timeout.Token).AsTask();
            var awaitingTask = Registry.SearchReviewCasesAsync(
                actor,
                new ReviewCaseSearch(
                    Status: ReviewCaseStatus.AwaitingSecondApproval,
                    Count: 4),
                timeout.Token).AsTask();
            var pendingTask = Registry.SearchReviewCasesAsync(
                actor,
                new ReviewCaseSearch(Status: ReviewCaseStatus.Pending, Count: 4),
                timeout.Token).AsTask();
            await Task.WhenAll(summaryTask, awaitingTask, pendingTask);

            Summary = await summaryTask;
            var awaiting = await awaitingTask;
            var pending = await pendingTask;
            PriorityReviews = awaiting.Items.Concat(pending.Items).Take(6).ToArray();
        }
        catch (OperationCanceledException) when (ComponentLifetime.IsCancellationRequested)
        {
            // The user navigated away while the provider request was in flight.
        }
        catch (OperationCanceledException exception)
        {
            Logger.LogWarning(
                "Tenant overview loading timed out with {ExceptionType}.",
                exception.GetType().Name);
            Error =
                "The registry took too long to respond. Check service health and try again.";
        }
        catch (RegistryException exception)
        {
            Error = exception.Message;
        }
        catch (HttpRequestException exception)
        {
            Logger.LogWarning(
                "Tenant overview provider request failed with {ExceptionType}.",
                exception.GetType().Name);
            Error =
                "The registry provider could not be reached. Try again in a moment.";
        }
        catch (Exception exception)
        {
            Logger.LogError(
                "Tenant overview loading failed with {ExceptionType}.",
                exception.GetType().Name);
            Error =
                "An unexpected error prevented the overview from loading. Try again. " +
                "If it continues, contact support with the time of the failure.";
        }
        finally
        {
            IsLoading = false;
        }
    }

    public void Dispose()
    {
        ComponentLifetime.Cancel();
        ComponentLifetime.Dispose();
    }
}
