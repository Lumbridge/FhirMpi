@page "/patients/{Id:guid}/edit"
@attribute [Authorize(Policy = "PatientWriteAccess")]
@inject RegistryService Registry
@inject PortalActorContextFactory Actors
@inject NavigationManager Navigation

<PageTitle>Update patient · OpenMPI</PageTitle>

<a class="back-link" href="/patients/@Id">← Back to enterprise identity</a>

<PageHeader
    Eyebrow="Portal-managed source record"
    Title="Update patient"
    Description="@($"Edit the {Actors.ManagedSourceSystem} source snapshot. Historical aliases are preserved for survivorship and matching.")" />

@if (LoadError is not null)
{
    <AlertMessage Tone="danger" Title="The patient could not be loaded" Message="@LoadError" />
}

@if (Model is null)
{
    @if (LoadError is null)
    {
        <div class="loading-panel" role="status">
            <span class="loading-spinner" aria-hidden="true"></span>
            <span>Loading the patient record…</span>
        </div>
    }
}
else
{
    <PatientRecordForm
        Model="Model"
        FormName="update-patient"
        SourceSystem="@Actors.ManagedSourceSystem.Value"
        SubmitLabel="Save patient"
        CancelHref="@($"/patients/{Id:D}")"
        AllowLocalReferenceEdit="false"
        IsSaving="IsSaving"
        SubmissionErrorTitle="The patient could not be updated"
        SubmissionError="@SaveError"
        OnValidSubmit="UpdateAsync" />
}

@code {
    [Parameter]
    public Guid Id { get; set; }

    private PatientRecordFormModel? Model { get; set; }

    private SourcePatientRecord? Source { get; set; }

    private string? LoadError { get; set; }

    private string? SaveError { get; set; }

    private bool IsSaving { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        LoadError = null;
        SaveError = null;
        Model = null;
        try
        {
            var actor = await Actors.CreateManagedSourceWriterAsync();
            var identity = await Registry.GetPatientIdentityViewAsync(
                actor,
                new EnterpriseId(Id),
                CancellationToken.None);
            Source = identity.SourcePatients.FirstOrDefault(source =>
                source.Key.SourceSystem == Actors.ManagedSourceSystem);
            if (Source is null)
            {
                LoadError =
                    $"This identity has no {Actors.ManagedSourceSystem} source record. " +
                    "Records owned by external source systems are read-only in the portal.";
                return;
            }

            Model = PatientRecordFormModel.From(Source);
        }
        catch (RegistryException exception)
        {
            LoadError = exception.Message;
        }
    }

    private async Task UpdateAsync()
    {
        if (Model is null || Source is null)
        {
            return;
        }

        IsSaving = true;
        SaveError = null;
        try
        {
            var actor = await Actors.CreateManagedSourceWriterAsync();
            var result = await Registry.UpsertPatientAsync(
                actor,
                new UpsertPatientCommand(
                    Source.Key,
                    Model.ToProfile(Source.Profile),
                    ExpectedVersion: Source.Version),
                CancellationToken.None);
            Navigation.NavigateTo(
                $"/patients/{result.CanonicalPatient.EnterpriseId.Value:D}?notice=updated");
        }
        catch (RegistryConcurrencyException)
        {
            SaveError =
                "This source record changed after the form was opened. " +
                "Reload the page and review the latest values before saving again.";
        }
        catch (RegistryException exception)
        {
            SaveError = exception.Message;
        }
        catch (ArgumentException exception)
        {
            SaveError = exception.Message;
        }
        finally
        {
            IsSaving = false;
        }
    }
}
