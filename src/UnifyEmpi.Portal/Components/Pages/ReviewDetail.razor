@page "/reviews/{Id:guid}"
@attribute [Authorize(Policy = "ReviewAccess")]
@inject RegistryService Registry
@inject PortalActorContextFactory Actors

<PageTitle>Identity review · UnifyEMPI</PageTitle>

<a class="back-link" href="/reviews">← Back to review queue</a>

@if (LoadError is not null)
{
    <AlertMessage Tone="danger" Title="The review could not be loaded" Message="@LoadError" />
}
else if (Detail is null)
{
    <div class="loading-panel" role="status">
        <span class="loading-spinner" aria-hidden="true"></span>
        <span>Loading the identity review…</span>
    </div>
}
else
{
    var review = Detail.ReviewCase;
    var approvalCount = review.Approvals?.Count ?? 0;
    var hasReplacedParticipants = HasReplacedParticipants(Detail);
    var hasVersionDrift = HasVersionDrift(Detail);
    var isOutdatedOpenReview =
        IsOpen(review) && (hasReplacedParticipants || hasVersionDrift);
    var showSupersededState =
        review.Status == ReviewCaseStatus.Superseded || isOutdatedOpenReview;
    var canCompleteUnderCurrentPolicy =
        !isOutdatedOpenReview &&
        review.Status == ReviewCaseStatus.AwaitingSecondApproval &&
        approvalCount >= Detail.EffectiveRequiredApprovals &&
        Detail.EffectiveRequiredApprovals < review.RequiredApprovals;
    <PageHeader
        Eyebrow="@PortalDisplay.ReviewKind(review.Kind)"
        Title="@ReviewTitle(review)"
        Description="@($"Review ID {review.Id}")">
        <Actions>
            <StatusBadge
                Label="@ReviewStatusLabel(review, isOutdatedOpenReview)"
                Tone="@(showSupersededState ? "neutral" : StatusTone(review.Status))" />
        </Actions>
    </PageHeader>

    @if (showSupersededState)
    {
        <section class="superseded-banner" role="status" aria-labelledby="superseded-heading">
            <span class="superseded-mark" aria-hidden="true">↗</span>
            <div class="superseded-content">
                @if (hasReplacedParticipants)
                {
                    <p class="eyebrow">Identity changed since review</p>
                    <h2 id="superseded-heading">This review has been superseded</h2>
                    <p>
                        One or more identities in this comparison have already been replaced.
                        The person has not been marked clinically inactive; the enterprise identity
                        has moved to a newer surviving record.
                    </p>
                    <div class="superseded-replacements">
                        @if (!Detail.Subject.CanonicalPatient.IsActive)
                        {
                            <div>
                                <span>Subject identity</span>
                                <strong>@ShortId(Detail.Subject.CanonicalPatient.EnterpriseId)</strong>
                                @if (Detail.Subject.CanonicalPatient.ReplacedBy is { } replacement)
                                {
                                    <small>Replaced by @ShortId(replacement)</small>
                                }
                                else
                                {
                                    <small>No replacement identity was recorded</small>
                                }
                            </div>
                        }
                        @if (Detail.Candidate is { CanonicalPatient.IsActive: false } candidate)
                        {
                            <div>
                                <span>Proposed survivor</span>
                                <strong>@ShortId(candidate.CanonicalPatient.EnterpriseId)</strong>
                                @if (candidate.CanonicalPatient.ReplacedBy is { } replacement)
                                {
                                    <small>Replaced by @ShortId(replacement)</small>
                                }
                                else
                                {
                                    <small>No replacement identity was recorded</small>
                                }
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p class="eyebrow">Evidence changed since review</p>
                    <h2 id="superseded-heading">This review needs fresh evidence</h2>
                    <p>
                        At least one active enterprise identity was updated after this review
                        captured its match evidence. The stored score and proposed outcome may
                        no longer reflect the current demographics.
                    </p>
                    <div class="superseded-replacements">
                        @if (SubjectVersionChanged(Detail))
                        {
                            <div>
                                <span>Subject identity</span>
                                <strong>@ShortId(Detail.Subject.CanonicalPatient.EnterpriseId)</strong>
                                <small>
                                    Captured version @review.SubjectVersion ·
                                    current version @Detail.Subject.CanonicalPatient.Version
                                </small>
                            </div>
                        }
                        @if (CandidateVersionChanged(Detail) && Detail.Candidate is not null)
                        {
                            <div>
                                <span>Proposed survivor</span>
                                <strong>@ShortId(Detail.Candidate.CanonicalPatient.EnterpriseId)</strong>
                                <small>
                                    Captured version @review.CandidateVersion ·
                                    current version @Detail.Candidate.CanonicalPatient.Version
                                </small>
                            </div>
                        }
                    </div>
                }
                <p>
                    Close this outdated review, then open a current identity and run duplicate
                    detection again to capture a fresh comparison.
                </p>
                <div class="superseded-actions">
                    @foreach (var currentIdentity in CurrentIdentityIds(Detail))
                    {
                        <a class="button button-secondary"
                           href="/patients/@currentIdentity">
                            Open current identity @ShortId(currentIdentity)
                        </a>
                    }
                </div>
            </div>
        </section>
    }

    @if (review.Status == ReviewCaseStatus.AwaitingSecondApproval && !isOutdatedOpenReview)
    {
        <section class="approval-banner">
            <span class="approval-number">@(canCompleteUnderCurrentPolicy ? "1" : "2")</span>
            <div>
                @if (canCompleteUnderCurrentPolicy)
                {
                    <strong>The current policy allows this link to be completed</strong>
                    <p>
                        This review recorded a two-approval requirement when it opened, but the tenant
                        now requires one. Submit the link action again with a final audit reason.
                    </p>
                }
                else
                {
                    <strong>A different reviewer must provide final approval</strong>
                    <p>The first approval is recorded. Self-approval is prevented by the service.</p>
                }
            </div>
        </section>
    }

    @if (review.Kind != ReviewCaseKind.Split)
    {
        <AssistedReviewPanel Detail="Detail" />
    }

    @if (review.Kind == ReviewCaseKind.Split)
    {
        <section class="comparison-grid comparison-single">
            <IdentityProfilePanel
                Profile="Detail.Subject.CanonicalPatient.Profile"
                Kicker="Identity being corrected" />
            <section class="panel split-manifest">
                <p class="eyebrow">Unlink and split</p>
                <h2>Source records to move</h2>
                <p>Approval creates a new enterprise identity and rebuilds both canonical records atomically.</p>
                <ul class="manifest-list">
                    @foreach (var source in review.SourcesToMove ?? [])
                    {
                        <li><strong>@source.SourceSystem</strong><span>@source.LocalId</span></li>
                    }
                </ul>
            </section>
        </section>
    }
    else
    {
        <section class="comparison-grid" aria-label="Identity comparison">
            <IdentityProfilePanel
                Profile="Detail.Subject.CanonicalPatient.Profile"
                Kicker="@SubjectKicker(review, Detail.Subject)">
                <Badge>
                    <span class="comparison-badges">
                        <span class="comparison-label">Subject</span>
                        @if (!Detail.Subject.CanonicalPatient.IsActive)
                        {
                            <StatusBadge Label="Replaced" Tone="neutral" />
                        }
                        else if (SubjectVersionChanged(Detail))
                        {
                            <StatusBadge Label="Changed" Tone="warning" />
                        }
                    </span>
                </Badge>
            </IdentityProfilePanel>
            @if (Detail.Candidate is not null)
            {
                <IdentityProfilePanel
                    Profile="Detail.Candidate.CanonicalPatient.Profile"
                    Kicker="@CandidateKicker(review, Detail.Candidate)">
                    <Badge>
                        <span class="comparison-badges">
                            <span class="comparison-label comparison-label-survivor">Survivor</span>
                            @if (!Detail.Candidate.CanonicalPatient.IsActive)
                            {
                                <StatusBadge Label="Replaced" Tone="neutral" />
                            }
                            else if (CandidateVersionChanged(Detail))
                            {
                                <StatusBadge Label="Changed" Tone="warning" />
                            }
                        </span>
                    </Badge>
                </IdentityProfilePanel>
            }
        </section>
        <EvidenceList Evidence="review.Evidence" Score="review.Score" Grade="review.Grade" />
    }

    <div class="decision-layout">
        <section class="panel decision-history" aria-labelledby="approval-history-heading">
            <div class="section-heading">
                <div>
                    <p class="eyebrow">Immutable evidence</p>
                    <h2 id="approval-history-heading">Approval history</h2>
                </div>
                <span class="result-note">
                    @if (Detail.EffectiveRequiredApprovals < review.RequiredApprovals)
                    {
                        @($"{approvalCount} recorded · {Detail.EffectiveRequiredApprovals} currently required")
                    }
                    else
                    {
                        @($"{approvalCount} of {review.RequiredApprovals}")
                    }
                </span>
            </div>
            @if (approvalCount == 0)
            {
                <p class="muted">No approval has been recorded yet.</p>
            }
            else
            {
                <ol class="timeline">
                    @foreach (var approval in review.Approvals ?? [])
                    {
                        <li>
                            <strong>@approval.Actor</strong>
                            <span>@PortalDisplay.Instant(approval.RecordedAt)</span>
                            <p>@approval.Reason</p>
                        </li>
                    }
                </ol>
            }
            @if (!string.IsNullOrWhiteSpace(review.DecisionReason))
            {
                <div class="decision-outcome">
                    <strong>Final reason</strong>
                    <p>@review.DecisionReason</p>
                </div>
            }
        </section>

        @if (IsOpen(review))
        {
            @if (isOutdatedOpenReview)
            {
                <section class="decision-card superseded-decision-card"
                         aria-labelledby="close-superseded-heading">
                    <p class="eyebrow">Safe resolution</p>
                    <h2 id="close-superseded-heading">Close this outdated review</h2>
                    <p>
                        Linking or rejecting these old identity versions could record the wrong
                        outcome. Closing the review as superseded removes it from open work and
                        writes an immutable audit event.
                    </p>
                    @if (ActionError is not null)
                    {
                        <SubmissionFeedback
                            Title="The review could not be closed"
                            Message="@ActionError" />
                    }
                    <div class="decision-actions">
                        <button class="button button-primary"
                            type="button"
                            disabled="@IsSubmitting"
                            @onclick="CloseSupersededAsync">
                            Close as superseded
                        </button>
                    </div>
                </section>
            }
            else
            {
                <section class="decision-card" aria-labelledby="record-decision-heading">
                    <p class="eyebrow">Reviewer action</p>
                    <h2 id="record-decision-heading">Record your decision</h2>
                    <p>@ActionExplanation(review, canCompleteUnderCurrentPolicy)</p>
                    @if (review.Kind != ReviewCaseKind.Split)
                    {
                        <fieldset class="review-checklist">
                            <legend>Complete the safety checks</legend>
                            <label>
                                <input type="checkbox" @bind="IdentifiersChecked" />
                                <span>
                                    <strong>Identifiers checked</strong>
                                    <small>I compared authoritative identifiers and investigated any conflict.</small>
                                </span>
                            </label>
                            <label>
                                <input type="checkbox" @bind="DemographicsChecked" />
                                <span>
                                    <strong>Demographics compared</strong>
                                    <small>I reviewed names, birth date, address and contact evidence.</small>
                                </span>
                            </label>
                            <label>
                                <input type="checkbox" @bind="SurvivorChecked" />
                                <span>
                                    <strong>Proposed survivor confirmed</strong>
                                    <small>I checked which enterprise identity will remain active after a link.</small>
                                </span>
                            </label>
                            <div class="checklist-progress">
                                <span>@CompletedCheckCount of 3 checks complete</span>
                                <progress max="3" value="@CompletedCheckCount">@CompletedCheckCount of 3</progress>
                            </div>
                        </fieldset>
                    }
                    <div class="field">
                        <label for="decision-reason">Clinical or operational rationale</label>
                        <textarea id="decision-reason"
                                  class="input textarea"
                                  rows="4"
                                  maxlength="1000"
                                  @bind="Reason"
                                  @bind:event="oninput"></textarea>
                        <small>Required. Do not include unnecessary clinical detail.</small>
                        @if (review.Kind != ReviewCaseKind.Split)
                        {
                            <div class="reason-prompts" aria-label="Rationale prompts">
                                <span>Start with:</span>
                                <button type="button" @onclick="UseLinkRationale">Link rationale</button>
                                <button type="button" @onclick="UseRejectRationale">Reject rationale</button>
                            </div>
                        }
                    </div>
                    @if (ActionError is not null)
                    {
                        <SubmissionFeedback
                            Title="The review could not be completed"
                            Message="@ActionError" />
                    }
                    else if (Success is not null)
                    {
                        <SubmissionFeedback
                            Tone="success"
                            Title="@Success" />
                    }
                    <div class="decision-actions">
                        <button class="button button-primary"
                                type="button"
                                disabled="@(IsSubmitting || !CanApprove(review))"
                                @onclick="ApproveAsync">
                            @ApproveLabel(review, canCompleteUnderCurrentPolicy)
                        </button>
                        <button class="button button-danger-outline"
                                type="button"
                                disabled="@(IsSubmitting || !CanReject(review))"
                                @onclick="RejectAsync">
                            Reject
                        </button>
                    </div>
                    @if (review.Kind != ReviewCaseKind.Split && CompletedCheckCount < 2)
                    {
                        <p class="operation-note">
                            Check identifiers and demographics before recording a decision.
                        </p>
                    }
                    else if (review.Kind != ReviewCaseKind.Split && !SurvivorChecked)
                    {
                        <p class="operation-note">
                            Confirm the proposed survivor to enable the link action.
                        </p>
                    }
                </section>
            }
        }
        else if (Success is not null)
        {
            <section class="decision-card">
                <p class="eyebrow">Reviewer action</p>
                <SubmissionFeedback
                    Tone="success"
                    Title="@Success" />
            </section>
        }
    </div>
}

@code {
    [Parameter]
    public Guid Id { get; set; }

    private ReviewCaseDetail? Detail { get; set; }

    private string Reason { get; set; } = string.Empty;

    private string? LoadError { get; set; }

    private string? ActionError { get; set; }

    private string? Success { get; set; }

    private bool IsSubmitting { get; set; }

    private bool IdentifiersChecked { get; set; }

    private bool DemographicsChecked { get; set; }

    private bool SurvivorChecked { get; set; }

    private Guid? LoadedReviewId { get; set; }

    private int CompletedCheckCount =>
        (IdentifiersChecked ? 1 : 0) +
        (DemographicsChecked ? 1 : 0) +
        (SurvivorChecked ? 1 : 0);

    protected override Task OnParametersSetAsync()
    {
        if (LoadedReviewId != Id)
        {
            LoadedReviewId = Id;
            IdentifiersChecked = false;
            DemographicsChecked = false;
            SurvivorChecked = false;
            Reason = string.Empty;
        }

        return LoadAsync();
    }

    private async Task LoadAsync()
    {
        LoadError = null;
        try
        {
            Detail = await Registry.GetReviewCaseDetailAsync(
                await Actors.CreateAsync(),
                Id,
                CancellationToken.None);
        }
        catch (RegistryException exception)
        {
            LoadError = exception.Message;
        }
    }

    private Task ApproveAsync() =>
        DecideAsync(Detail?.ReviewCase.Kind == ReviewCaseKind.Split
            ? ReviewDecision.Split
            : ReviewDecision.Link);

    private Task RejectAsync() => DecideAsync(ReviewDecision.Reject);

    private bool CanApprove(ReviewCase review) =>
        review.Kind == ReviewCaseKind.Split ||
        (IdentifiersChecked && DemographicsChecked && SurvivorChecked);

    private bool CanReject(ReviewCase review) =>
        review.Kind == ReviewCaseKind.Split ||
        (IdentifiersChecked && DemographicsChecked);

    private void UseLinkRationale()
    {
        Reason =
            "Identifiers and demographic evidence were reviewed. The records are judged to " +
            "represent the same person, and the proposed survivor was confirmed because ";
    }

    private void UseRejectRationale()
    {
        Reason =
            "Identifiers and demographic evidence were reviewed. The records are judged to " +
            "represent different people because ";
    }

    private Task CloseSupersededAsync() =>
        DecideAsync(
            ReviewDecision.Supersede,
            SupersessionReason(Detail!));

    private async Task DecideAsync(
        ReviewDecision decision,
        string? explicitReason = null)
    {
        if (Detail is null)
        {
            return;
        }

        var decisionReason = explicitReason ?? Reason;
        if (string.IsNullOrWhiteSpace(decisionReason))
        {
            Success = null;
            ActionError = "Enter a meaningful reason before recording this decision.";
            return;
        }

        IsSubmitting = true;
        ActionError = null;
        Success = null;
        try
        {
            var updated = await Registry.DecideReviewCaseAsync(
                await Actors.CreateAsync(),
                new ReviewDecisionCommand(
                    Id,
                    decision,
                    decisionReason.Trim(),
                    Detail.ReviewCase.Version),
                CancellationToken.None);
            Success = updated.Status switch
            {
                ReviewCaseStatus.AwaitingSecondApproval =>
                    "Your approval is recorded. A different reviewer must provide final approval.",
                ReviewCaseStatus.Superseded =>
                    "The outdated review is closed as superseded.",
                _ =>
                    $"The review is complete: {PortalDisplay.ReviewStatus(updated.Status).ToLowerInvariant()}."
            };
            if (explicitReason is null)
            {
                Reason = string.Empty;
            }
            Detail = await Registry.GetReviewCaseDetailAsync(
                await Actors.CreateAsync(),
                Id,
                CancellationToken.None);
        }
        catch (RegistryException exception)
        {
            ActionError = exception.Message;
            await LoadAsync();
            if (Detail is not null &&
                (HasReplacedParticipants(Detail) || HasVersionDrift(Detail)))
            {
                ActionError = null;
            }
        }
        finally
        {
            IsSubmitting = false;
        }
    }

    private static string ReviewTitle(ReviewCase review) =>
        review.Kind == ReviewCaseKind.Split
            ? "Separate incorrectly linked source records"
            : "Resolve a possible duplicate identity";

    private static string ActionExplanation(
        ReviewCase review,
        bool canCompleteUnderCurrentPolicy) =>
        canCompleteUnderCurrentPolicy
            ? "Confirm completion under the tenant's current one-approval policy. The original approval and this final action remain in the audit trail."
            : review.Kind == ReviewCaseKind.Split
            ? "Confirm that the selected source records belong to a different person."
            : "Confirm that both records represent the same person. The candidate identity shown as survivor will remain active.";

    private static string ApproveLabel(
        ReviewCase review,
        bool canCompleteUnderCurrentPolicy) =>
        canCompleteUnderCurrentPolicy
            ? "Complete link under current policy"
            : review.Kind == ReviewCaseKind.Split
                ? "Approve split"
                : "Approve link";

    private static bool IsOpen(ReviewCase review) =>
        review.Status is ReviewCaseStatus.Pending or ReviewCaseStatus.AwaitingSecondApproval;

    private static bool HasReplacedParticipants(ReviewCaseDetail detail) =>
        !detail.Subject.CanonicalPatient.IsActive ||
        detail.Candidate is { CanonicalPatient.IsActive: false };

    private static bool HasVersionDrift(ReviewCaseDetail detail) =>
        SubjectVersionChanged(detail) || CandidateVersionChanged(detail);

    private static bool SubjectVersionChanged(ReviewCaseDetail detail) =>
        detail.ReviewCase.SubjectVersion > 0 &&
        detail.Subject.CanonicalPatient.Version != detail.ReviewCase.SubjectVersion;

    private static bool CandidateVersionChanged(ReviewCaseDetail detail) =>
        detail.Candidate is not null &&
        detail.ReviewCase.CandidateVersion.HasValue &&
        detail.Candidate.CanonicalPatient.Version !=
            detail.ReviewCase.CandidateVersion.Value;

    private static IReadOnlyList<EnterpriseId> CurrentIdentityIds(ReviewCaseDetail detail)
    {
        var identities = new List<EnterpriseId>(2);
        AddCurrentIdentity(identities, detail.Subject);
        if (detail.Candidate is not null)
        {
            AddCurrentIdentity(identities, detail.Candidate);
        }

        return identities.Distinct().ToArray();
    }

    private static void AddCurrentIdentity(
        ICollection<EnterpriseId> identities,
        PatientIdentityView identity)
    {
        if (identity.CanonicalPatient.IsActive)
        {
            identities.Add(identity.CanonicalPatient.EnterpriseId);
        }
        else if (identity.CanonicalPatient.ReplacedBy is { } replacement)
        {
            identities.Add(replacement);
        }
    }

    private static string SupersessionReason(ReviewCaseDetail detail)
    {
        var replaced = new List<string>(2);
        if (!detail.Subject.CanonicalPatient.IsActive)
        {
            replaced.Add("the subject enterprise identity");
        }

        if (detail.Candidate is { CanonicalPatient.IsActive: false })
        {
            replaced.Add("the proposed survivor enterprise identity");
        }

        if (replaced.Count > 0)
        {
            var verb = replaced.Count == 1 ? "was" : "were";
            return $"Review superseded because {string.Join(" and ", replaced)} " +
                   $"{verb} replaced after the review was created.";
        }

        var changed = new List<string>(2);
        if (SubjectVersionChanged(detail))
        {
            changed.Add(
                $"the subject identity changed from version " +
                $"{detail.ReviewCase.SubjectVersion} to " +
                $"{detail.Subject.CanonicalPatient.Version}");
        }

        if (CandidateVersionChanged(detail))
        {
            changed.Add(
                $"the proposed survivor changed from version " +
                $"{detail.ReviewCase.CandidateVersion} to " +
                $"{detail.Candidate!.CanonicalPatient.Version}");
        }

        return $"Review superseded because {string.Join(" and ", changed)} " +
               "after the evidence was captured.";
    }

    private static string ReviewStatusLabel(
        ReviewCase review,
        bool isOutdatedOpenReview) =>
        isOutdatedOpenReview
            ? "Superseded"
            : PortalDisplay.ReviewStatus(review.Status);

    private static string SubjectKicker(
        ReviewCase review,
        PatientIdentityView subject)
    {
        if (subject.CanonicalPatient.IsActive &&
            review.SubjectVersion > 0 &&
            subject.CanonicalPatient.Version != review.SubjectVersion)
        {
            return "Identity changed since this review opened";
        }

        return subject.CanonicalPatient.IsActive
            ? "Identity that will be replaced"
            : review.Status == ReviewCaseStatus.Linked
                ? "Identity replaced by this review"
                : "Identity replaced since this review opened";
    }

    private static string CandidateKicker(
        ReviewCase review,
        PatientIdentityView candidate)
    {
        if (candidate.CanonicalPatient.IsActive &&
            review.CandidateVersion.HasValue &&
            candidate.CanonicalPatient.Version != review.CandidateVersion.Value)
        {
            return "Proposed survivor changed since this review opened";
        }

        return candidate.CanonicalPatient.IsActive
            ? "Identity that will survive"
            : review.Status == ReviewCaseStatus.Linked
                ? "Survivor subsequently replaced"
                : "Proposed survivor replaced since this review opened";
    }

    private static string ShortId(EnterpriseId id)
    {
        var value = id.ToString();
        return $"{value[..8]}…{value[^4..]}";
    }

    private static string StatusTone(ReviewCaseStatus status) =>
        status switch
        {
            ReviewCaseStatus.Linked or ReviewCaseStatus.Split => "success",
            ReviewCaseStatus.AwaitingSecondApproval => "warning",
            ReviewCaseStatus.Rejected or ReviewCaseStatus.Superseded => "neutral",
            _ => "info"
        };
}
