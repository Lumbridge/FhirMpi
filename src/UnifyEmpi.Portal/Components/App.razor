<!DOCTYPE html>
<html lang="en-GB">
@inject Microsoft.Extensions.Options.IOptions<PortalOptions> PortalConfiguration
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#13283f" />
    <meta name="description" content="UnifyEMPI enterprise identity operations portal" />
    <base href="/" />
    <link rel="stylesheet" href="app.css" />
    <HeadOutlet @rendermode="PortalRenderMode" />
</head>
<body>
    <Routes @rendermode="PortalRenderMode" />
    <script src="_framework/blazor.web.js"></script>
</body>
</html>

@code {
    private InteractiveServerRenderMode PortalRenderMode =>
        new(prerender: PortalConfiguration.Value.PrerenderInteractiveComponents);
}
